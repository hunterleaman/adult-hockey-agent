{
  "APPEND_ONLY_FILES": "docs/CHANGELOG.md, docs/DECISIONS.md",
  "BUILD_COMMAND": "npm run build",
  "CTX_BUDGET_TOKENS": 125000,
  "LONG_BUILD_COMMAND": "npm run build",
  "LONG_BUILD_TIMEOUT_MS": 600000,
  "MAX_DEFERRED_CONSIDERS": 5,
  "PIPELINE_SENTINEL_FILE": "dist/scheduler.js",
  "POST_BUILD_CHECKS": "test -f dist/index.js && test -f dist/scraper.js && test -f dist/session-identity.js && node -e \"import('./dist/scraper.js').then((m) => { if (typeof m.scrapeEvents !== 'function') { console.error('scrapeEvents export missing'); process.exit(1) } })\" && ! grep -rn \"company=extremeice\" src/scraper.ts src/evaluator.ts src/config.ts src/index.ts src/commands/",
  "PROJECT_NAME": "adult-hockey-agent",
  "QUALITY_GATE_FAST_STEPS": "npm run check",
  "QUALITY_GATE_ONE_LINER": "npm run check && npm run build",
  "QUALITY_GATE_SCRIPT": ": # n/a -- no quality gate script configured for adult-hockey-agent",
  "TEST_COMMAND": "npm run test"
}
